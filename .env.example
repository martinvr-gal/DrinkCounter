DATABASE_URL=postgresql+psycopg://gallery:gallery@db:5432/gallery
JWT_SECRET=replace-with-a-long-random-secret
UPLOAD_FOLDER=/app/uploads
TV_INTERVAL_SECONDS=10
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
MAX_UPLOAD_BYTES=10485760
VITE_API_URL=http://localhost:8000
# Base pública del backend WebSocket; también puede dejarse vacía para usar el mismo dominio.
VITE_WS_URL=ws://localhost:8000
CORS_ORIGINS=http://localhost:5173
COUNTER_DATABASE_PATH=/app/counter-data/counter.db
CLIPS_FOLDER=/app/clips
ADS_FOLDER=/app/anuncios
VITE_TV_AD_EVERY_PHOTOS=10
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://localhost:8000/admin/spotify/callback
SPOTIFY_DEFAULT_PLAYLIST=
SPOTIFY_REFRESH_TOKEN=
SPOTIFY_AUTOPLAY=true
# Opcional. Se crea automáticamente al autorizar Spotify por primera vez.
SPOTIFY_TOKEN_PATH=counter-data/spotify-token.json
